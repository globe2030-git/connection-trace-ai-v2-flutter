# google_mlkit_text_recognition(google_mlkit_commons)이 iOS 15.5 이상을 요구해서
# Flutter 기본값(13.0)보다 높여야 함.
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # google_mlkit_text_recognition의 iOS podspec은 GoogleMLKit/TextRecognition
  # (라틴 전용) 서브스펙만 의존성으로 선언한다 — 한국어 인식 서브스펙은 여기서
  # 직접 추가해줘야 링크된다. 플러그인 네이티브 코드(GoogleMlKitTextRecognitionPlugin.m)
  # 가 `#if __has_include(<MLKitTextRecognitionKorean/...>)`로 컴파일 타임에
  # 존재 여부를 체크하는데, 이 pod이 없으면 그 분기 자체가 컴파일에서 빠져서
  # Dart에서 TextRecognitionScript.korean을 지정해도 조용히 라틴 인식기로
  # 폴백해버린다. 그동안 iOS에서 명함 한글이 제대로 인식되지 않은 근본 원인.
  pod 'GoogleMLKit/TextRecognitionKorean', '~> 9.0.0'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # 최신 Xcode의 "모듈 검증(Module Verifier)"이 nanopb/GTMSessionFetcher/
      # google_mlkit_* 등 Google 쪽 pod의 헤더가 큰따옴표(") import를 쓴다고,
      # 또 검증용으로 격리된 상태로 빌드하다 보니 Flutter.h를 못 찾는다고 실기기
      # (iphoneos) 빌드에서 에러로 잡아버림 — 기능상 문제가 아니라 새로 생긴 더
      # 엄격한 검사라서 끈다. 관련 키가 두 개라 둘 다 꺼야 함.
      config.build_settings['CLANG_ENABLE_MODULE_VERIFIER'] = 'NO'
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'

      # pod 들의 최소 iOS 버전을 앱과 같은 15.5 로 통일한다(2026-09-05).
      #
      # 왜: abseil·gRPC·leveldb·Promises 등이 아직 iOS 9.0/10.0/11.0 을
      # 선언하고 있어, 새 Xcode 가 매 빌드마다 **경고 24건**을 낸다:
      #
      #   The iOS deployment target 'IPHONEOS_DEPLOYMENT_TARGET' is set to
      #   9.0, but the range of supported deployment target versions is
      #   12.0 to 26.5.99.
      #
      # 📌 **경고를 방치하면 새 경고가 묻힌다**(globe2030님 지적). 이 앱은
      # 어차피 `platform :ios, '15.5'` 라 그보다 낮은 타깃으로 빌드될 일이
      # 없다 — 숫자를 실물에 맞추는 것뿐이고 동작은 그대로다.
      #
      # ⚠️ **내리는 것이 아니라 올리는 것이다.** 낮은 최소 버전을 요구하는
      # pod 은 없다(있다면 그 pod 이 15.5 미만 API 를 쓴다는 뜻인데, 앱이
      # 이미 15.5 이므로 그런 pod 은 애초에 못 쓴다).
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
    end
  end
end
