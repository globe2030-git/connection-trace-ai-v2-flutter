<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<!-- ⚠️ iOS는 **앱이 선언한 언어로만** 시스템 화면을 보여 준다(2026-08-16
       실기기 확인). 이 목록에 한국어가 없어서, 애플이 한국어를 갖고 있는데도
       문서 스캐너가 "Ready for next scan." "Position the document in view."
       처럼 **영어로 나왔다.**

       스캐너만의 문제가 아니다 — 사진 선택·공유·권한 창 등 **iOS가 그리는
       모든 화면**이 영어였다. 앱 자체는 한글인데 시스템 화면만 영어라, 쓰는
       사람에게는 앱이 반쯤 영어로 보인다.

       ko를 먼저 둔다(기본 언어). en은 그대로 남겨 해외 기기에서도 뜨게 한다. -->
		<key>CFBundleLocalizations</key>
		<array>
			<string>ko</string>
			<string>en</string>
		</array>
		<!-- iOS는 여기에 적은 스킴만 canOpenURL로 조회할 수 있다. 없으면 카카오톡이
       깔려 있어도 "설치돼 있지 않다"로 판정된다(사용자 보고, 2026-08-10). -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>kakaotalk</string>
		</array>
		<key>CFBundleDisplayName</key>
		<string>커넥션센스</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>ConnectionSense</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>주변 인맥과의 거리를 계산하기 위해 현재 위치 정보가 필요합니다.</string>
		<!-- 앱은 위치를 "사용 중에만" 요청하지만, geolocator 플러그인이 '항상 허용'
		     위치 API를 코드에서 참조해 Apple 정적 검사(90683)가 이 목적 문자열까지
		     요구한다. 실제로 '항상 허용' 권한을 요청하지 않으므로 사용자에게 해당
		     팝업은 표시되지 않는다. -->
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>주변 인맥과의 거리를 계산하기 위해 현재 위치 정보가 필요합니다.</string>
		<key>NSCameraUsageDescription</key>
		<string>명함을 촬영해 자동으로 인식하기 위해 카메라 접근 권한이 필요합니다.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>갤러리에 저장된 명함 이미지를 불러와 자동으로 인식하기 위해 사진 라이브러리 접근 권한이 필요합니다.</string>
		<!-- 이메일(Gmail) 연동을 위한 Google 로그인 설정 — Google Cloud Console에서
		     발급받은 iOS OAuth 클라이언트 ID. -->
		<key>GIDClientID</key>
		<string>79345379389-io34er4vnhnc1dln8791ov4624mf6tv6.apps.googleusercontent.com</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLSchemes</key>
				<array>
					<!-- 클라이언트 ID를 거꾸로 뒤집은 형태(Google 로그인 콜백을 앱으로
					     되돌려받기 위한 URL 스킴) -->
					<string>com.googleusercontent.apps.79345379389-io34er4vnhnc1dln8791ov4624mf6tv6</string>
				</array>
			</dict>
		</array>
		<!-- 미국 수출규정(EAR) 질문에 대한 답 — 이 앱은 "예외 대상이 아닌 암호화"를
		     쓰지 않는다(P1-21, 2026-08-27 코드 실사 근거로 판단).

		     이 값을 false로 두면 App Store Connect가 제출마다 묻는 수출규정
		     질문을 건너뛴다. 근거로 삼은 것은 이 저장소 lib/ 전체에서 실제로
		     쓰는 암호화 넷뿐이다 — 전부 애플이 스스로 "예외"로 분류하는 범주에
		     들어간다.

		     ① HTTPS/TLS — Firebase·행안부/카카오/네이버 REST·Cloud Functions
		        호출 전부 표준 TLS. 표준 인터넷 프로토콜은 예외(§740.17(b)(1)).
		     ② AES-256-GCM — lib/core/services/data_crypto_service.dart. 명함·
		        프로필·그룹처럼 제3자 개인정보를 기기/서버에 저장할 때 쓴다.
		        NIST 표준 알고리즘이고, 구현체(cryptography 패키지)는 자체
		        개발이 아니라 무료 공개 오픈소스 라이브러리 — 독자 개발
		        알고리즘이 아니라 "표준" 암호화다.
		     ③ SHA-256 — lib/data/repositories/auth_repository.dart. Apple
		        로그인의 재전송 공격 방지용 nonce 해시로만 쓴다. "인증 목적만"은
		        애플이 명시한 예외 항목이다.
		     ④ flutter_secure_storage — iOS Keychain(애플 자체 API)에 위임할
		        뿐 이 앱이 직접 구현한 암호화가 아니다.

		     넷 다 "독자 개발/비표준 알고리즘"이 아니고, 암호화 자체를 상품으로
		     팔거나 라이선스하지 않으며, 군사·정부 대상 특수 용도도 아니다 —
		     소비자 대상 무료 앱이 표준 암호화를 이용자 자신의 데이터 보호에만
		     쓰는, 애플 문서가 예로 드는 전형적인 예외 사례에 해당한다.

		     ⚠️ 이 값은 애플 제출 절차만 정한다. 실제 미국 수출관리규정(EAR)상
		     회사가 별도로 BIS에 자체분류 보고를 해야 하는지는 다른 문제이고
		     이 판단에 포함되지 않는다 — 필요하면 법무 검토를 따로 받는다. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>NSFaceIDUsageDescription</key>
	<string>앱 잠금을 켜면 명함첩을 열 때 본인 확인에 Face ID를 사용합니다.</string>
</dict>
</plist>
