{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "connection-sense",
          "appId": "1:79345379389:android:24e13cbaadaf82ac182254",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "connection-sense",
          "appId": "1:79345379389:ios:534c871d9bfd7d78182254",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "connection-sense",
          "configurations": {
            "android": "1:79345379389:android:24e13cbaadaf82ac182254",
            "ios": "1:79345379389:ios:534c871d9bfd7d78182254"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "legal",
      "public": "docs/legal",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "**/.*",
        "**/node_modules/**",
        "reviews/**",
        "**/*.md"
      ],
      "redirects": [
        { "source": "/privacy", "destination": "/privacy-policy", "type": 301 },
        { "source": "/terms", "destination": "/terms-of-service", "type": 301 },
        { "source": "/permissions", "destination": "/app-permissions", "type": 301 },
        { "source": "/legal", "destination": "/", "type": 301 },
        { "source": "/legal/**", "destination": "/", "type": 301 }
      ],
      "headers": [
        {
          "source": "**/*.@(html|css)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=300" }
          ]
        }
      ]
    },
    {
      "target": "admin",
      "public": "docs/admin",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "**/.*",
        "**/node_modules/**",
        "README.md"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self' https://*.googleapis.com https://asia-northeast3-connection-sense.cloudfunctions.net; frame-src https://connection-sense.firebaseapp.com https://accounts.google.com https://apis.google.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" }
          ]
        }
      ]
    },
    {
      "target": "site",
      "public": "docs/site",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "**/.*",
        "**/node_modules/**",
        "README.md"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=300" }
          ]
        },
        {
          "source": "**/*.@(html|css)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=300" }
          ]
        },
        {
          "source": "**/*.woff2",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        }
      ]
    }
  ]
}