{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "connection-sense",
          "appId": "1:79345379389:android:24e13cbaadaf82ac182254",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "connection-sense",
          "appId": "1:79345379389:ios:711add75920b0390182254",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "connection-sense",
          "configurations": {
            "android": "1:79345379389:android:24e13cbaadaf82ac182254",
            "ios": "1:79345379389:ios:711add75920b0390182254"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "legal",
      "public": "docs/legal",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        { "source": "/privacy", "destination": "/privacy-policy", "type": 301 },
        { "source": "/terms", "destination": "/terms-of-service", "type": 301 },
        { "source": "/permissions", "destination": "/app-permissions", "type": 301 },
        { "source": "/legal", "destination": "/", "type": 301 },
        { "source": "/legal/**", "destination": "/", "type": 301 }
      ],
      "headers": [
        {
          "source": "**/*.@(html|css)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=300" }
          ]
        }
      ]
    },
    {
      "target": "admin",
      "public": "docs/admin",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "**/.*",
        "**/node_modules/**",
        "README.md"
      ]
    }
  ]
}