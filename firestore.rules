rules_version = '2';

// 명함/인맥 데이터 백업·복원용 Firestore 보안 규칙.
// 원칙: 본인(uid) 소유 데이터만 본인만 읽고 쓸 수 있다. 로그인 안 한 요청은 전부 거부.
// 참고: docs/planning/backlog.md 추가 66, docs/planning/HANDOFF.md "2-0".
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 관리자 화이트리스트 — Firebase 콘솔에 들어가 Authentication 계정을
    // 수동으로 만들거나 Firestore에 admins/{uid} 문서를 손으로 추가할 필요 없이,
    // 관리자 콘솔 페이지에서 이 이메일로 직접 회원가입하면 그대로 관리자가 되게
    // 하는 방식(2026-08-06 전환). 이메일 인증까지 요구하는 이유: 이메일 자체가
    // 사실상 비밀번호 역할이라(가입 시점엔 소유 확인이 없음), 인증 메일을
    // 실제로 받을 수 있는 사람만 관리자가 되도록 막는 마지막 방어선이다.
    // 관리자를 추가하려면 이 배열에 이메일만 추가하면 됨(Firebase 콘솔 불필요).
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'connectionsense@creamhouse.net',
          // 그룹메일(위)이 회사 Google Workspace 그룹 게시 권한 설정 탓에
          // Firebase 인증 메일을 못 받아(2026-08-06 확인) 개인 메일도
          // 같이 허용. 그룹메일 수신 문제를 나중에 해결하면 지워도 됨.
          'globe@creamhouse.net'
        ];
    }

    // 개인정보처리방침 등 법적 문서 — 누구나 읽을 수 있어야 하고(로그인 전
    // 사용자도 봐야 함), 관리자만 수정한다.
    match /legalDocs/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 공지사항 — published=true인 것만 일반 사용자에게 공개, 초안은 관리자만.
    match /notices/{noticeId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 1:1 문의 — 본인 문의만 읽고 쓸 수 있고, 관리자는 전체를 본다. 작성 후
    // 사용자가 원문을 고치지 못하게 update는 관리자만 허용(상태 변경 등).
    match /inquiries/{inquiryId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;

      match /replies/{replyId} {
        allow read: if isAdmin() || (request.auth != null &&
          get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.userId == request.auth.uid);
        allow create: if isAdmin() || (request.auth != null &&
          get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.userId == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // `users/{uid}` 문서에 클라이언트가 직접 쓸 수 있는 필드.
    //
    // 여기에 없는 필드(대표적으로 `aiUsage`)는 서버만 쓴다. Cloud Functions는
    // Admin SDK로 접근해 보안 규칙을 우회하므로, 클라이언트 쓰기를 막아도
    // 서버 동작에는 영향이 없다.
    function clientWritableUserFields() {
      return ['encryptionKeyB64', 'profile', 'updatedAt'];
    }

    // 이미 발급된 암호화 키는 바꿀 수 없다. 키가 바뀌면 그 키로 암호화해 둔
    // 서버 백업 전체를 영원히 열 수 없게 된다 — 악의보다 버그로 터질 확률이
    // 높은 종류의 사고라 규칙으로 막는다. 아직 없을 때 처음 넣는 것만 허용.
    function encryptionKeyUnchanged() {
      return !('encryptionKeyB64' in resource.data) ||
        request.resource.data.encryptionKeyB64 == resource.data.encryptionKeyB64;
    }

    match /users/{uid} {
      // 읽기는 문서 전체 허용 — 앱이 `encryptionKeyB64`(기기 변경 시 복원용,
      // backlog 추가 72)와 `profile`을 모두 읽어야 한다.
      allow read: if isOwner(uid);

      // 계정 삭제(설정 → 계정 삭제)에서 이 문서를 통째로 지운다.
      allow delete: if isOwner(uid);

      // ⚠️ 2026-08-06 강화(P0-8, backlog 추가 82).
      //
      // 이전에는 `allow read, write: if isOwner(uid)`로 문서 **전체** 쓰기를
      // 허용했다. 그 판단은 이 문서에 `encryptionKeyB64`밖에 없던 시점의
      // 것이었는데, 이후 AI 프록시가 호출 한도 카운터(`aiUsage`)를 같은
      // 문서에 기록하기 시작하면서 구멍이 됐다 — 로그인한 사용자가 앱을
      // 거치지 않고 SDK로 `aiUsage.dailyCount = 0`을 써넣으면 일 10회 한도가
      // 무한 초기화되고, 그 비용은 회사 명의 유료 Gemini 키로 나간다.
      //
      // 그래서 쓰기를 필드 단위로 좁힌다. 앱은 `merge: true`로만 쓰므로
      // 건드리지 않은 필드는 `affectedKeys()`에 잡히지 않는다.
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(clientWritableUserFields());

      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(clientWritableUserFields()) &&
        encryptionKeyUnchanged();

      match /contacts/{contactId} {
        allow read, write: if isOwner(uid);

        match /commLogs/{logId} {
          allow read, write: if isOwner(uid);
        }
      }
    }

    // 명시적으로 나열되지 않은 모든 경로는 기본 거부.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
