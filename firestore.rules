rules_version = '2';

// 명함/인맥 데이터 백업·복원용 Firestore 보안 규칙.
// 원칙: 본인(uid) 소유 데이터만 본인만 읽고 쓸 수 있다. 로그인 안 한 요청은 전부 거부.
// 참고: docs/planning/backlog.md 추가 66, docs/planning/HANDOFF.md "2-0".
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 관리자 화이트리스트 — Cloud Functions/커스텀 클레임 없이(Blaze 미전환 상태라
    // Admin SDK로 클레임을 심어줄 방법이 없음) 관리자 콘솔을 쓸 수 있게 하는
    // 가장 단순한 방법. admins/{uid} 문서 존재 여부만으로 판단하고, 그 컬렉션
    // 자체는 클라이언트가 직접 읽거나 쓸 수 없다(Firebase 콘솔에서 수동으로만
    // 문서를 추가/삭제) — 그래야 공격자가 자기 uid로 문서를 만들어 스스로
    // 관리자가 되는 걸 막을 수 있다.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    // 개인정보처리방침 등 법적 문서 — 누구나 읽을 수 있어야 하고(로그인 전
    // 사용자도 봐야 함), 관리자만 수정한다.
    match /legalDocs/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 공지사항 — published=true인 것만 일반 사용자에게 공개, 초안은 관리자만.
    match /notices/{noticeId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 1:1 문의 — 본인 문의만 읽고 쓸 수 있고, 관리자는 전체를 본다. 작성 후
    // 사용자가 원문을 고치지 못하게 update는 관리자만 허용(상태 변경 등).
    match /inquiries/{inquiryId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;

      match /replies/{replyId} {
        allow read: if isAdmin() || (request.auth != null &&
          get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.userId == request.auth.uid);
        allow create: if isAdmin() || (request.auth != null &&
          get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.userId == request.auth.uid);
        allow update, delete: if false;
      }
    }

    match /users/{uid} {
      // `encryptionKeyB64`(backlog 추가 72 — 암호화 대칭키 백업 필드)도
      // 이 문서 전체 규칙에 포함되므로 본인 uid만 읽고 쓸 수 있다. 별도
      // 필드 단위 규칙을 추가할 필요 없음(2026-08-04 확인).
      allow read, write: if isOwner(uid);

      match /contacts/{contactId} {
        allow read, write: if isOwner(uid);

        match /commLogs/{logId} {
          allow read, write: if isOwner(uid);
        }
      }
    }

    // 명시적으로 나열되지 않은 모든 경로는 기본 거부.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
