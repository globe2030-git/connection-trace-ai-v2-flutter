rules_version = '2';

// 명함/인맥 데이터 백업·복원용 Firestore 보안 규칙.
// 원칙: 본인(uid) 소유 데이터만 본인만 읽고 쓸 수 있다. 로그인 안 한 요청은 전부 거부.
// 참고: docs/planning/backlog.md 추가 66, docs/planning/HANDOFF.md "2-0".
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 관리자 화이트리스트 — Firebase 콘솔에 들어가 Authentication 계정을
    // 수동으로 만들거나 Firestore에 admins/{uid} 문서를 손으로 추가할 필요 없이,
    // 관리자 콘솔 페이지에서 이 이메일로 직접 회원가입하면 그대로 관리자가 되게
    // 하는 방식(2026-08-06 전환). 이메일 인증까지 요구하는 이유: 이메일 자체가
    // 사실상 비밀번호 역할이라(가입 시점엔 소유 확인이 없음), 인증 메일을
    // 실제로 받을 수 있는 사람만 관리자가 되도록 막는 마지막 방어선이다.
    //
    // ⚠️ 2026-08-14(ADMIN-VULN-001): `getUserUsage`·`grantBonusCredits`
    // Cloud Functions는 이 Rules를 거치지 않고 Admin SDK로 직접 접근하므로,
    // 자체 이메일 목록(`functions/src/adminEmails.ts`의 ADMIN_EMAILS)을 따로
    // 갖는다. Rules는 외부 파일을 import할 수 없어(리터럴만 가능) 진짜 단일
    // 원본으로 합칠 수 없다 — 대신 **아래 배열은 adminEmails.ts의
    // ADMIN_EMAILS와 내용이 정확히 같아야 한다.** 관리자를 추가/제거할 때는
    // 두 곳을 함께 고치고 `python3 tool/check_admin_sync.py`로 확인한 뒤
    // `firebase deploy --only firestore:rules,functions`로 동시에 배포한다
    // (docs/admin/README.md "관리자 판별 방식" 참고). 이 방식은 임시 조치이며
    // 진짜 단일 원본(config/admins 문서 + Rules get()) 전환이 후속 과제다.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'connectionsense@creamhouse.net',
          // 그룹메일(위)이 회사 Google Workspace 그룹 게시 권한 설정 탓에
          // Firebase 인증 메일을 못 받아(2026-08-06 확인) 개인 메일도
          // 같이 허용. 그룹메일 수신 문제를 나중에 해결하면 지워도 됨.
          'globe@creamhouse.net'
        ];
    }

    // 개인정보처리방침 등 법적 문서 — 누구나 읽을 수 있어야 하고(로그인 전
    // 사용자도 봐야 함), 관리자만 수정한다.
    match /legalDocs/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 테스터 허용목록(config/testers) — 스토어를 거치지 않은 테스트 빌드에서
    // AI를 쓸 수 있게 관리자 콘솔에서 이메일을 등록/삭제하는 문서. 관리자만
    // 읽고 쓴다. 서버(generateBriefing)는 Admin SDK로 읽어 규칙을 우회한다.
    // config 아래 다른 문서는 명시 전까지 기본 거부(맨 아래 catch-all).
    match /config/testers {
      allow read, write: if isAdmin();
    }

    // 충전 상품 설정(config/billing) — 티어별 제공 회수·무료 횟수. 관리자
    // 콘솔에서 편집하고, 앱은 충전 화면에서 읽는다(IAP 구현 시). 값 자체는
    // 비밀이 아니라 로그인 사용자 누구나 읽어도 된다. 쓰기는 관리자만.
    //
    // ⚠️ 2026-08-15(ADMIN-VULN-004): 예전에는 스키마 검증 없이 관리자 쓰기를
    // 전면 허용했다. 원인은 이 문서 자체가 아니라 admin.js의 loadBilling()
    // 템플릿이 Firestore에서 읽은 t.credits/t.active 값을 HTML 속성
    // (value="...", checked) 안에 이스케이프 없이 그대로 삽입한 것이었다 —
    // 탈취/오조작된 관리자 세션이 credits에 `"><script>...` 같은 문자열을
    // 넣으면 다음 관리자 로그인 때 속성탈출 XSS가 실행됐다. admin.js도 값을
    // DOM 프로퍼티로 안전하게 채우도록 고쳤지만, 방어는 한 겹으로 끝내지
    // 않고 Rules에서도 스키마 자체를 강제한다.
    // 휴대폰 인증 게이트 스위치(추가 571).
    //
    // 🚨 **이 문서가 없으면 게이트가 안 켜진다.** 지갑(과금)이 쓴 방식과 같다
    // — 코드가 서버에 올라가는 것과 기능이 켜지는 것을 가른다. 실제 스위치는
    // **`enforce: true` 필드를 만드는 것** 하나이고, 그것은 사용자 결정이다.
    //
    // ⚠️ **켜는 순간 `phoneVerifiedAt`이 없는 계정이 전부 인증 화면으로
    // 간다.** 기존 이용자를 어떻게 할지(전원 인증 / 신규만 / 유예 기간)를
    // 정하기 전에는 켜지 않는다.
    //
    // 앱이 읽어야 하므로 로그인한 사람에게 read 를 연다(config/billing 과 같다).
    match /config/phoneVerification {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /config/billing {
      allow read: if request.auth != null;
      allow write: if isAdmin() && isValidBillingConfig(request.resource.data);
    }

    // config/billing 쓰기 스키마 검증. 가격 7단계는 docs/admin/admin.js의
    // TIER_PRICES와 정확히 같아야 한다(admin.js가 항상 이 7개 가격으로
    // tiers 배열을 구성해서 보낸다 — billingSaveBtn 핸들러 참고).
    function isValidBillingTier(t) {
      return t is map &&
        t.keys().hasOnly(['priceKrw', 'credits', 'active']) &&
        'priceKrw' in t &&
        t.priceKrw in [1000, 3000, 5000, 10000, 30000, 50000, 100000] &&
        (!('credits' in t) || t.credits == null ||
          (t.credits is int && t.credits >= 1 && t.credits <= 1000000)) &&
        'active' in t && t.active is bool;
    }

    function isValidBillingConfig(d) {
      return d.keys().hasOnly(['freeCredits', 'tiers', 'updatedAt']) &&
        'freeCredits' in d && d.freeCredits is int &&
        d.freeCredits >= 0 && d.freeCredits <= 100000 &&
        'tiers' in d && d.tiers is list && d.tiers.size() == 7 &&
        isValidBillingTier(d.tiers[0]) && isValidBillingTier(d.tiers[1]) &&
        isValidBillingTier(d.tiers[2]) && isValidBillingTier(d.tiers[3]) &&
        isValidBillingTier(d.tiers[4]) && isValidBillingTier(d.tiers[5]) &&
        isValidBillingTier(d.tiers[6]) &&
        (!('updatedAt' in d) || d.updatedAt == request.time);
    }

    // 앱 업데이트 게이트(config/appUpdate, P1-45) — 최소지원/최신 빌드번호,
    // 스토어 URL, 안내문구. 앱이 시작 시(로그인 전에도) 읽어 강제/권장 업데이트를
    // 판단해야 하므로 공개 읽기, 편집은 관리자만. 비밀이 아니다.
    //
    // ⚠️ 2026-08-14(ADMIN-VULN-003): 관리자가 여기 저장하는 URL을 앱이 그대로
    // 외부 실행한다(강제 업데이트는 닫기 불가). 탈취/오조작된 관리자 세션이
    // 임의 URL을 넣으면 전 사용자를 피싱 사이트로 보내거나 앱을 soft-brick할
    // 수 있어, 공식 스토어 host만 허용하는 스키마 검증을 Rules에서 강제한다.
    match /config/appUpdate {
      allow read: if true;
      allow write: if isAdmin() && isValidAppUpdateConfig(request.resource.data);
    }

    // config/appUpdate 쓰기 스키마 검증. 공식 스토어 URL(또는 빈 문자열 —
    // 아직 URL을 안 정한 초기 상태)만 허용하고, 빌드 번호는 모두 음이 아닌
    // 정수, 최소 지원 빌드는 최신 빌드를 넘을 수 없다. message는 있으면
    // 문자열이고 300자 이하만 허용(옵션 필드).
    function isValidAppUpdateConfig(d) {
      return
        (d.iosUrl == '' || d.iosUrl.matches('^https://apps\\.apple\\.com/.+$')) &&
        (d.androidUrl == '' || d.androidUrl.matches('^https://play\\.google\\.com/.+$')) &&
        d.minSupportedBuildIos is int && d.minSupportedBuildIos >= 0 &&
        d.minSupportedBuildAndroid is int && d.minSupportedBuildAndroid >= 0 &&
        d.latestBuildIos is int && d.latestBuildIos >= 0 &&
        d.latestBuildAndroid is int && d.latestBuildAndroid >= 0 &&
        d.minSupportedBuildIos <= d.latestBuildIos &&
        d.minSupportedBuildAndroid <= d.latestBuildAndroid &&
        (!('message' in d) || (d.message is string && d.message.size() <= 300));
    }

    // 충전(결제) 기록 — 고객응대·정산용. 영수증 검증을 통과한 서버(P1-4,
    // Admin SDK)만 기록하고 클라이언트 쓰기는 전면 금지한다(위조 방지 —
    // 여기 쓰기가 열리면 결제 없이 크레딧을 만들 수 있게 된다). 관리자만 읽는다.
    match /purchases/{purchaseId} {
      allow read: if isAdmin();
    }

    // AI 호출 감사 로그 — 불만 처리·비용 추적용. 관리자만 읽는다. 클라이언트는
    // 절대 쓰지 못하고(위조 방지), 서버(generateBriefing)만 Admin SDK로 기록한다.
    // 소셜 로그인 이용자의 제공자 이메일(2026-08-21, B안).
    //
    // ⚠️ 서버(Admin SDK)만 읽고 쓴다. 클라이언트는 **읽지도 못한다** —
    // 관리자도 마찬가지다. 테스터 허용목록 대조에만 쓰이는 값이라 사람이
    // 들여다볼 이유가 없다.
    //
    // 📌 아래 catch-all 기본 거부로도 같은 결과지만, **개인정보가 담긴
    // 컬렉션은 눈에 보이게 적어 둔다**(aiAuditLogs와 같은 이유). 목록에
    // 없으면 다음 사람이 "빠뜨린 것"인지 "일부러 막은 것"인지 모른다.
    //
    // ⚠️ 이 규칙은 기본 거부와 동작이 같아 **배포하지 않아도 차이가 없다.**
    match /socialTesterEmails/{uid} {
      allow read, write: if false;
    }

    // 카카오 연결 해제 웹훅의 접수 장부(functions/src/kakaoUnlink.ts).
    //
    // 서버만 쓰고 읽는다. **클라이언트는 절대 손대면 안 된다** — 여기에 문서를
    // 만들 수 있으면 남의 uid를 적어 넣어 그 계정을 통째로 지울 수 있다.
    // 파기 트리거가 이 컬렉션의 문서 생성으로 도는 구조라 더욱 그렇다.
    //
    // ⚠️ 이 규칙도 기본 거부와 동작이 같아 배포하지 않아도 차이가 없다.
    // 그래도 적어 두는 이유는 위 socialTesterEmails와 같다.
    match /socialUnlinkRequests/{uid} {
      allow read, write: if false;
    }

    // ── 휴대전화번호 인증(추가 565) ───────────────────────────────────────
    //
    // 🚨 **셋 다 서버 전용이다. 클라이언트가 읽을 수 있으면 안 된다.**
    //
    // 특히 phoneAccounts 가 위험하다. 이것은 **번호 해시 → uid 매핑**이라,
    // 읽히면 **아무나 번호를 넣어 보고 그 사람이 가입했는지 캐낼 수 있다.**
    // 이 앱은 제3자(명함 주인)의 개인정보를 다루므로 더 무겁다.
    //
    // ⚠️ 번호를 해시로 두는 것은 그 자체로 방어가 아니다 — 휴대폰 번호는
    // 경우의 수가 좁아서(01Ｘ-XXXX-XXXX) **전수 대입이 현실적이다.** 해시는
    // "서버가 새도 원문이 안 남는다"를 위한 것이고, **캐내기를 막는 것은 이
    // 규칙**이다. 둘을 헷갈리면 안 된다.
    //
    // ⚠️ 기본 거부와 동작이 같아 배포하지 않아도 차이는 없다. 그래도 적어
    // 두는 이유는 위 socialTesterEmails 와 같다 — 빠뜨린 것인지 일부러 막은
    // 것인지 다음 사람이 알아야 한다.

    // 번호 해시 → uid. 「이 번호는 누구인가」의 유일한 기록.
    match /phoneAccounts/{phoneHash} {
      allow read, write: if false;
    }

    // 살아 있는 인증번호. 🚨 평문 코드는 여기에도 없다(해시만 담는다).
    match /phoneOtpChallenges/{phoneHash} {
      allow read, write: if false;
    }

    // 발송 장부 — 하루 상한·재발송 간격 판정의 근거.
    //
    // 🚨 **이것이 기기가 아니라 서버에 있는 것이 핵심이다.** 기기에 두면
    // 앱을 지웠다 깔아서 상한을 초기화할 수 있다.
    match /phoneSendLedger/{phoneHash} {
      allow read, write: if false;
    }

    match /aiAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 무료 크레딧 지급 감사 원장(2026-08-14, ADMIN-VULN-002) — 누가·언제·왜·
    // 얼마를·어떤 잔액에서 어떤 잔액으로 바꿨는지 기록하는 불변 원장이자
    // operationId 멱등성 체크용 문서. 클라이언트는 절대 쓰지 못하고(위조·삭제
    // 방지) grantBonusCredits(Admin SDK)만 트랜잭션 안에서 기록한다. 관리자만
    // 읽는다.
    match /creditGrantAudits/{opId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 관리자 콘솔 감사 로그(2026-08-15, ADMIN-VULN-010, 인터림 조치) — 공지·
    // 문의답변·과금설정·테스터·앱업데이트 게이트처럼 파급력이 큰 관리자
    // 조작을 누가·언제·무엇을 했는지 기록한다. append-only(update/delete 금지)
    // 이고, actorUid/actorEmail은 요청자 본인 것과 일치해야 해 "다른 관리자
    // 행세"를 막는다.
    //
    // ⚠️ 이건 **완전한 위조 방지가 아니다.** 대상 문서 쓰기(예: config/billing
    // 저장)와 이 감사 기록 생성이 같은 트랜잭션이 아니라서, 악성/탈취 관리자가
    // 대상 문서만 쓰고 감사 기록 호출(admin.js의 logAdminAudit)을 의도적으로
    // 생략하면 아무것도 안 남는다. 완전한 원자성은 grantBonusCredits
    // (creditGrantAudits 패턴)처럼 해당 변경 자체를 Callable Function으로
    // 옮겨 같은 트랜잭션에서 감사 기록까지 함께 쓰도록 전환해야 하며, 이는
    // 후속 과제다(비용/위험이 큰 billing·testers·appUpdate부터 우선 전환 추천).
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidAdminAuditEntry(request.resource.data);
      allow update, delete: if false;
    }

    // adminAuditLogs 생성 스키마 검증. action은 admin.js의 logAdminAudit
    // 호출 9곳과 정확히 일치하는 고정 목록만 허용한다.
    function isValidAdminAuditEntry(d) {
      return d.keys().hasOnly(
        ['actorUid', 'actorEmail', 'action', 'target', 'summary', 'at']
      ) &&
        'actorUid' in d && d.actorUid is string &&
        d.actorUid == request.auth.uid &&
        'actorEmail' in d && d.actorEmail is string &&
        d.actorEmail == request.auth.token.email &&
        'action' in d && d.action in [
          'billing.save', 'testers.add', 'testers.remove', 'appUpdate.save',
          'notice.create', 'notice.toggle', 'notice.delete',
          'inquiry.reply', 'inquiry.markAnswered'
        ] &&
        'target' in d && d.target is string && d.target.size() <= 200 &&
        'summary' in d && d.summary is string && d.summary.size() <= 500 &&
        'at' in d && d.at == request.time;
    }

    // wallet(지갑형) 크레딧 잔액 변동 히스토리 — 무료 지급(가입 시 1회성)/
    // 고객응대 무료 지급/충전 3종의 출처별 감사 추적(ai-credit-wallet-spec.md
    // §2-3, §2-5). purchases·aiAuditLogs와 같은 패턴: 서버(Admin SDK)만
    // 기록하고, 클라이언트 쓰기는 위조 방지를 위해 전면 금지. 히스토리는
    // "관리자만 본다"는 요구를 규칙 레벨에서 강제한다.
    //
    // ⚠️ creditGrantAudits(위, 관리자 CS 지급 감사)와 목적이 다른 별개
    // 컬렉션이다 — 하나는 "관리자가 왜 지급했는지"의 감사 원장이고, 이건
    // "지갑 잔액이 어떤 출처로 얼마나 변했는지"의 사용자별 히스토리다. 통합
    // 여부는 PM 확인 후 별도 결정.
    match /creditGrants/{grantId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 리퍼럴(추천인) 코드 → uid 매핑(monetization-referral-implementation
    // -spec-2026-08-14.md §3-1). 코드 발급은 서버(bootstrapAccount, Admin
    // SDK)만 하고, 클라이언트는 절대 직접 읽거나 쓰지 못한다 — "코드 검증은
    // 항상 콜러블을 통해서만"이라는 원칙을 규칙 레벨에서 강제한다. 코드
    // "입력(redemption)" 검증 콜러블은 다음 라운드 몫이지만, 이 규칙은
    // 지금 함께 넣어 둔다.
    match /referralCodes/{code} {
      allow read, write: if false;
    }

    // Apple refresh_token 보관(탈퇴 시 폐기용, P1-38). 민감 토큰이라 클라이언트는
    // 읽지도 쓰지도 못한다 — 서버(storeAppleRefreshToken / onUserDeletedCleanup)만
    // Admin SDK로 접근한다.
    match /appleAuth/{uid} {
      allow read, write: if false;
    }

    // 기기 단위 무료체험 지급 이력(U5, 재가입×무료체험 무한 루프 방어).
    // monetization-referral-engineering-spec-2026-08-14.md §4-2: 문서 ID는
    // 서버가 계산한 deviceHash(raw device id의 HMAC-SHA256)이고, 원문 기기
    // 식별자·개인정보는 담지 않는다. appleAuth와 동일 패턴 — 클라이언트는
    // 절대 읽지도 쓰지도 못하고 bootstrapAccount(Admin SDK)만 접근한다.
    // ⚠️ 계정 삭제(onUserDeletedCleanup)가 이 컬렉션을 건드리지 않는 것이
    // 이 설계의 핵심이다 — users/{uid}는 탈퇴 시 파기되지만 이 문서는
    // 계정과 무관하게 남아 재가입 시에도 같은 기기임을 식별한다.
    match /deviceLedger/{deviceHash} {
      allow read, write: if false;
    }

    // 명함 인식 품질 통계(2026-08-11). 필드별 인식률·이름 추출 경로·사용자 수정
    // 카운트 등 **형태(숫자)만** 담고 개인정보(이름/전화/이메일/주소 원문)는
    // 담지 않는다 — 관리자 콘솔에서 전 사용자 인식률을 보기 위한 것이다.
    // 소유자 쓰기를 허용한다: 여기 값은 곧 돈·한도가 아니라 통계라, 조작해도
    // 관리자 화면만 지저분해질 뿐 보안·비용 영향이 없다(aiUsage와 대비되는
    // 지점 — 그건 서버 전용이다). 읽기는 관리자만.
    //
    // ⚠️ 2026-08-14(ADMIN-VULN-009): 쓰기가 스키마 검증 없이 전면 허용돼 있어
    // 임의의 최상위 필드·비정상 타입·과대한 카운터 값을 끼워 넣을 수 있었다.
    // isValidOcrStats()로 필드·타입·범위를 고정한다.
    match /ocrStats/{uid} {
      allow read: if isAdmin();
      // 감소(이전 값보다 작은 값)는 검증하지 말고 허용한다 — 설정 화면의
      // "측정값 초기화" 버튼(ocr_stats_view.dart, _service.reset())이 로컬
      // 저장소만 지우고 서버 문서(ocrStats/{uid})는 그대로 두기 때문에,
      // 초기화 후 다음 스캔에서는 로컬 카운트가 0부터 다시 시작해 서버의
      // 이전(더 큰) 값보다 작은 값이 정상적으로 올라온다. 여기서 감소를
      // 막으면 이 정상 초기화 플로우 자체가 깨진다. 이 데이터는 돈·한도가
      // 아니라 통계라 감소 허용의 보안·비용 영향은 없다(2026-08-14,
      // ADMIN-VULN-009).
      allow write: if isOwner(uid) && isValidOcrStats(request.resource.data);
    }

    // ocrStats 쓰기 스키마 검증. Firestore rules는 재귀 함수를 지원하지
    // 않으므로 맵 타입별로 고정된 키 목록을 나열하는 명시적 검증 함수를 쓴다
    // (isValidAppUpdateConfig와 같은 스타일 — 필드별 옵셔널 체크
    // `(!('key' in m) || isOcrCount(m.key))` 패턴). 모든 카운터는
    // 0~1,000,000 범위의 정수만 허용한다(상한은 실사용으로 도달 불가능한
    // 안전판, 임의의 과대 카운터 차단용) — **상한 검증**이지 단조 증가
    // 강제가 아니다(감소는 허용, 위 주석 참고).
    function isOcrCount(v) {
      return v is int && v >= 0 && v <= 1000000;
    }

    // OcrParseShape 9개 필드(lib/core/services/ocr_scanner_service.dart)와
    // 일치하는 키만 허용.
    function isValidOcrFilledMap(m) {
      return m.keys().hasOnly([
        'name', 'company', 'title', 'mobile', 'office',
        'email', 'address', 'addressDetail', 'postal'
      ]) &&
        (!('name' in m) || isOcrCount(m.name)) &&
        (!('company' in m) || isOcrCount(m.company)) &&
        (!('title' in m) || isOcrCount(m.title)) &&
        (!('mobile' in m) || isOcrCount(m.mobile)) &&
        (!('office' in m) || isOcrCount(m.office)) &&
        (!('email' in m) || isOcrCount(m.email)) &&
        (!('address' in m) || isOcrCount(m.address)) &&
        (!('addressDetail' in m) || isOcrCount(m.addressDetail)) &&
        (!('postal' in m) || isOcrCount(m.postal));
    }

    // OcrNameSource enum 11종(ocr_scanner_service.dart)과 일치하는 키만 허용.
    function isValidOcrNameSourceMap(m) {
      return m.keys().hasOnly([
        'keywordSplit', 'koreanStripped', 'mixedTokenFront', 'mixedTokenLast',
        'leftoverFallback', 'fontSizePreferred', 'romanizedSurname',
        'mergedWithAddress', 'splitFromTitle', 'hangulTokenPreferred',
        'rawLineRecheck', 'none'
      ]) &&
        (!('keywordSplit' in m) || isOcrCount(m.keywordSplit)) &&
        (!('koreanStripped' in m) || isOcrCount(m.koreanStripped)) &&
        (!('mixedTokenFront' in m) || isOcrCount(m.mixedTokenFront)) &&
        (!('mixedTokenLast' in m) || isOcrCount(m.mixedTokenLast)) &&
        (!('leftoverFallback' in m) || isOcrCount(m.leftoverFallback)) &&
        (!('fontSizePreferred' in m) || isOcrCount(m.fontSizePreferred)) &&
        (!('romanizedSurname' in m) || isOcrCount(m.romanizedSurname)) &&
        (!('mergedWithAddress' in m) || isOcrCount(m.mergedWithAddress)) &&
        (!('splitFromTitle' in m) || isOcrCount(m.splitFromTitle)) &&
        (!('hangulTokenPreferred' in m) || isOcrCount(m.hangulTokenPreferred)) &&
        (!('rawLineRecheck' in m) || isOcrCount(m.rawLineRecheck)) &&
        (!('none' in m) || isOcrCount(m.none));
    }

    // OcrCompanySource enum 3종(ocr_scanner_service.dart)과 일치하는 키만 허용.
    function isValidOcrCompanySourceMap(m) {
      return m.keys().hasOnly(['keyword', 'leftoverPick', 'none']) &&
        (!('keyword' in m) || isOcrCount(m.keyword)) &&
        (!('leftoverPick' in m) || isOcrCount(m.leftoverPick)) &&
        (!('none' in m) || isOcrCount(m.none));
    }

    // corrections 하위 맵 — {unchanged/edited/cleared: count} 형태만 허용.
    function isValidOcrCorrectionEntry(v) {
      return v is map && v.keys().hasOnly(['unchanged', 'edited', 'cleared']) &&
        (!('unchanged' in v) || isOcrCount(v.unchanged)) &&
        (!('edited' in v) || isOcrCount(v.edited)) &&
        (!('cleared' in v) || isOcrCount(v.cleared));
    }

    // corrections — 키는 OcrParseShape 9개 필드명과 동일
    // (add_card_modal_view.dart의 finalValues), 값은 위 하위 맵.
    function isValidOcrCorrectionsMap(m) {
      return m.keys().hasOnly([
        'name', 'company', 'title', 'mobile', 'office',
        'email', 'address', 'addressDetail', 'postal'
      ]) &&
        (!('name' in m) || isValidOcrCorrectionEntry(m.name)) &&
        (!('company' in m) || isValidOcrCorrectionEntry(m.company)) &&
        (!('title' in m) || isValidOcrCorrectionEntry(m.title)) &&
        (!('mobile' in m) || isValidOcrCorrectionEntry(m.mobile)) &&
        (!('office' in m) || isValidOcrCorrectionEntry(m.office)) &&
        (!('email' in m) || isValidOcrCorrectionEntry(m.email)) &&
        (!('address' in m) || isValidOcrCorrectionEntry(m.address)) &&
        (!('addressDetail' in m) || isValidOcrCorrectionEntry(m.addressDetail)) &&
        (!('postal' in m) || isValidOcrCorrectionEntry(m.postal));
    }

    function isValidOcrStats(d) {
      return d.keys().hasOnly([
        'scans', 'correctedCards', 'filled', 'nameSource', 'companySource',
        'corrections', 'platform', 'updatedAt'
      ]) &&
        (!('scans' in d) || isOcrCount(d.scans)) &&
        (!('correctedCards' in d) || isOcrCount(d.correctedCards)) &&
        (!('filled' in d) || (d.filled is map && isValidOcrFilledMap(d.filled))) &&
        (!('nameSource' in d) || (d.nameSource is map && isValidOcrNameSourceMap(d.nameSource))) &&
        (!('companySource' in d) || (d.companySource is map && isValidOcrCompanySourceMap(d.companySource))) &&
        (!('corrections' in d) || (d.corrections is map && isValidOcrCorrectionsMap(d.corrections))) &&
        (!('platform' in d) || (d.platform is string && d.platform.size() <= 20)) &&
        (!('updatedAt' in d) || d.updatedAt == request.time);
    }

    // 파일럿(베타) 계측 이벤트(2026-08-15) — 개인정보 없이 숫자·플래그·채널
    // 종류만 담는 불변 로그(docs/planning/beta-observability-plan.md).
    // 이름·전화번호·이메일·대화 포인트 원문은 이 컬렉션에 절대 담지 않는다.
    //
    // 같은 하위 컬렉션에 쓰기 주체가 다른 두 종류의 이벤트가 섞여 있다:
    // - activation(활성화, 명함 3장+AI 1회): generateBriefing 성공 직후
    //   서버(Admin SDK)만 기록한다. 클라이언트가 스스로 활성화 이벤트를
    //   만들어낼 수 있으면 지표가 위조되므로 아래 검증에서 이 타입은 아예
    //   허용 목록에 넣지 않는다 — 결과적으로 클라이언트 쓰기는 항상 거부.
    // - copy_send(대화 포인트 복사/전송)·feedback(브리핑 반응) — 클라이언트가
    //   본인 uid 하위에만 생성 가능. 로그는 불변이라 수정·삭제는 막는다
    //   (aiAuditLogs·creditGrants와 같은 "불변 감사 로그" 원칙).
    //
    // 읽기는 관리자만 — ocrStats(형태 통계)와 달리 "누가 언제 어떤 행동을
    // 했는지"가 드러날 수 있어 사용자 본인에게도 열지 않는다.
    function isValidPilotClientEvent(d) {
      return d.uid is string &&
        (
          (d.type == 'copy_send' &&
            d.channel in ['call', 'sms', 'kakao', 'email'] &&
            d.keys().hasOnly(['type', 'uid', 'at', 'channel'])) ||
          (d.type == 'feedback' &&
            d.keys().hasOnly(['type', 'uid', 'at', 'thumbsUp', 'rating']) &&
            (!('thumbsUp' in d) || d.thumbsUp is bool) &&
            (!('rating' in d) || (d.rating is int && d.rating >= 1 && d.rating <= 5)) &&
            (('thumbsUp' in d) || ('rating' in d)))
        );
    }

    match /pilotEvents/{uid}/events/{eventId} {
      allow read: if isAdmin();
      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        isValidPilotClientEvent(request.resource.data);
      allow update, delete: if false;
    }

    // 공지사항 — published=true인 것만 일반 사용자에게 공개, 초안은 관리자만.
    match /notices/{noticeId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 1:1 문의 — 본인 문의만 읽고 쓸 수 있고, 관리자는 전체를 본다. 작성 후
    // 사용자가 원문을 고치지 못하게 update는 관리자만 허용(상태 변경 등).
    //
    // ⚠️ 2026-08-14(ADMIN-VULN-005): create/replies.create가 스키마 검증
    // 없이 userId(문의)/from(답변) 외 필드를 자유롭게 허용해서, 일반
    // 사용자가 status를 'answered'로 위조하거나 답변 서브컬렉션에
    // `from: 'admin'`을 끼워 넣어 관리자 답변을 위조할 수 있었다.
    // isValidInquiryCreate()/isValidInquiryReplyCreate()로 앱이 실제로
    // 보내는 필드(toCreatePayload/addUserReply/addAdminReply)만 고정한다.
    match /inquiries/{inquiryId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
        isValidInquiryCreate(request.resource.data);
      allow update: if isAdmin();
      allow delete: if false;

      match /replies/{replyId} {
        allow read: if isAdmin() || (request.auth != null &&
          get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.userId == request.auth.uid);
        allow create: if isValidInquiryReplyCreate(inquiryId, request.resource.data);
        allow update, delete: if false;
      }
    }

    // inquiries 생성 스키마 검증. lib/data/models/inquiry_model.dart의
    // toCreatePayload()가 보내는 정확히 7개 필드만 허용한다. userId·userEmail은
    // 요청자 본인 것과 일치해야 하고(로그인 성립 시 앱이 항상 그렇게 보낸다),
    // status는 항상 'pending' 고정, createdAt은 서버 시각과 같아야 한다(클라
    // 시각 위조 방지).
    function isValidInquiryCreate(d) {
      return d.keys().hasOnly(
        ['userId', 'userName', 'userEmail', 'subject', 'message', 'status', 'createdAt']
      ) &&
        'userId' in d && d.userId is string && d.userId == request.auth.uid &&
        'userEmail' in d && d.userEmail is string &&
        d.userEmail == request.auth.token.email &&
        (!('userName' in d) || (d.userName is string && d.userName.size() <= 100)) &&
        'subject' in d && d.subject is string &&
        d.subject.size() > 0 && d.subject.size() <= 200 &&
        'message' in d && d.message is string &&
        d.message.size() > 0 && d.message.size() <= 5000 &&
        'status' in d && d.status == 'pending' &&
        'createdAt' in d && d.createdAt == request.time;
    }

    // inquiries/{id}/replies 생성 스키마 검증. inquiry_repository.dart의
    // addUserReply()/addAdminReply()가 보내는 정확히 3개 필드만 허용한다.
    // 관리자가 쓰면 from은 반드시 'admin', 문의 소유자 본인이 쓰면 from은
    // 반드시 'user'다 — 그 외(타인이 from='user'로 쓰거나, 일반 사용자가
    // from='admin'으로 위조)는 모두 거부된다.
    function isValidInquiryReplyCreate(inquiryId, d) {
      return d.keys().hasOnly(['from', 'message', 'createdAt']) &&
        'message' in d && d.message is string &&
        d.message.size() > 0 && d.message.size() <= 5000 &&
        'createdAt' in d && d.createdAt == request.time &&
        (
          (isAdmin() && d.from == 'admin') ||
          (request.auth != null &&
            get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.userId == request.auth.uid &&
            d.from == 'user')
        );
    }

    // `users/{uid}` 문서에 클라이언트가 직접 쓸 수 있는 필드.
    //
    // 여기에 없는 필드(대표적으로 `aiUsage`)는 서버만 쓴다. Cloud Functions는
    // Admin SDK로 접근해 보안 규칙을 우회하므로, 클라이언트 쓰기를 막아도
    // 서버 동작에는 영향이 없다.
    // photoImprovementConsent / photoImprovementConsentAt (2026-08-15, 추가 218)
    // — "여러 이용자의 명함 사진을 함께 이용한 인식 알고리즘 개선"에 대한
    // 별도 동의다. 기기에만 두면 누가 동의했는지 회사가 알 수 없어 "동의한
    // 사람 것만 쓴다"를 지킬 수 없으므로 서버에도 남긴다. 동의는 본인만
    // 켜고 끌 수 있어야 하므로 클라이언트 쓰기 목록에 넣는다(값은 불리언과
    // 시각뿐이라 개인정보가 아니다).
    function clientWritableUserFields() {
      return [
        'encryptionKeyB64',
        'profile',
        'updatedAt',
        'photoImprovementConsent',
        'photoImprovementConsentAt',
        // 명함 그룹 목록(추가 427) — GroupsRepository가 이 필드에 암호화해
        // 쓴다. 빠뜨리면 클라이언트 쓰기가 여기서 거부된다(법무 검토 질문 3).
        'groups',
        // ⚠️ 427 작업 중 발견: DataBackupService.recordAccountSwitch도 이
        // 앱(클라이언트 SDK, FirebaseFirestore.instance)에서 이 문서에
        // accountSwitches 필드를 쓰는데 이 목록에 없었다 — 즉 계정 전환
        // 기록이 조용히 실패하고 있었을 수 있다(호출부가 실패를 삼키고
        // debugPrint만 남기는 구조라 화면에 드러나지 않는다). 그룹 필드를
        // 손보는 김에 함께 추가한다.
        'accountSwitches',
        // 광고 수신 동의(추가 472) — AdConsentService 가 이 필드들에 쓴다.
        // ⚠️ 빠뜨리면 쓰기가 여기서 조용히 거부된다. 위 accountSwitches 가
        // 바로 그렇게 빠져 있던 사례다.
        // 🚨 adConsentAt 은 철회해도 지우지 않는다 — 입증자료·2년 재확인
        //    기산점·통지 증적이 함께 사라지기 때문이다(법률 조사 추가 457).
        //    photoImprovementConsentAt 은 철회 시 null 로 지우는데, 그것을
        //    여기 복사하면 안 된다.
        'adConsentEmail',
        'adConsentPush',
        'adConsentAt',
        'adConsentChangedAt',
        'adConsentNotifiedAt',
      ];
    }

    // 이미 발급된 암호화 키는 바꿀 수 없다. 키가 바뀌면 그 키로 암호화해 둔
    // 서버 백업 전체를 영원히 열 수 없게 된다 — 악의보다 버그로 터질 확률이
    // 높은 종류의 사고라 규칙으로 막는다. 아직 없을 때 처음 넣는 것만 허용.
    function encryptionKeyUnchanged() {
      return !('encryptionKeyB64' in resource.data) ||
        request.resource.data.encryptionKeyB64 == resource.data.encryptionKeyB64;
    }

    match /users/{uid} {
      // 읽기는 문서 전체 허용 — 앱이 `encryptionKeyB64`(기기 변경 시 복원용,
      // backlog 추가 72)와 `profile`을 모두 읽어야 한다.
      allow read: if isOwner(uid);

      // 계정 삭제(설정 → 계정 삭제)에서 이 문서를 통째로 지운다.
      allow delete: if isOwner(uid);

      // ⚠️ 2026-08-06 강화(P0-8, backlog 추가 82).
      //
      // 이전에는 `allow read, write: if isOwner(uid)`로 문서 **전체** 쓰기를
      // 허용했다. 그 판단은 이 문서에 `encryptionKeyB64`밖에 없던 시점의
      // 것이었는데, 이후 AI 프록시가 호출 한도 카운터(`aiUsage`)를 같은
      // 문서에 기록하기 시작하면서 구멍이 됐다 — 로그인한 사용자가 앱을
      // 거치지 않고 SDK로 `aiUsage.dailyCount = 0`을 써넣으면 일 10회 한도가
      // 무한 초기화되고, 그 비용은 회사 명의 유료 Gemini 키로 나간다.
      //
      // 그래서 쓰기를 필드 단위로 좁힌다. 앱은 `merge: true`로만 쓰므로
      // 건드리지 않은 필드는 `affectedKeys()`에 잡히지 않는다.
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(clientWritableUserFields());

      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(clientWritableUserFields()) &&
        encryptionKeyUnchanged();

      match /contacts/{contactId} {
        allow read, write: if isOwner(uid);

        match /commLogs/{logId} {
          allow read, write: if isOwner(uid);
        }
      }

      // 삭제 기록(tombstone) — 다기기 동기화(P1-39 A안)에서 삭제 전파용.
      // 본인만 읽고 쓴다. id·삭제시각만 들어가며 개인정보는 없다.
      match /deletedContacts/{contactId} {
        allow read, write: if isOwner(uid);
      }
    }

    // 명시적으로 나열되지 않은 모든 경로는 기본 거부.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
