rules_version = '2';

// 명함 원본 사진/프로필 사진 저장용 Storage 보안 규칙.
// 원칙: 본인(uid) 소유 폴더만 본인만 읽고 쓸 수 있다. 로그인 안 한 요청은 전부 거부.
// 참고: docs/planning/backlog.md 추가 66, docs/planning/HANDOFF.md "2-0".
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 이미지 파일만, 5MB 이하로 제한 (명함/프로필 사진은 이 정도면 충분히 여유 있음).
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // 명함 원본 사진은 **암호문**으로 올라온다(2026-08-15, backlog 추가 218).
    //
    // 앱이 로컬에 AES-256-GCM으로 암호화해 둔 `nonce+ciphertext+mac` 바이트를
    // 복호화 없이 그대로 올리므로, contentType이 image/*가 아니라
    // application/octet-stream이다. 위 isValidImage()로는 통과할 수 없어
    // 별도 검사를 둔다 — 규칙과 CardPhotoBackupService._contentType이
    // 어긋나면 업로드가 조용히 거부된다.
    //
    // 크기 상한은 이미지와 같은 5MB로 맞춘다. 암호문은 원본보다 nonce·MAC
    // 28바이트만 커지므로 사실상 동일한 제한이다.
    function isValidEncryptedCard() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
    }

    // 🚨 `write` 를 쓰지 말 것 — 삭제까지 막힌다 (2026-08-26, 추가 517)
    //
    // `allow write` 는 **create·update·delete 를 다 덮는다.** 그런데 삭제
    // 요청에는 **`request.resource` 가 없다** — 올리는 내용이 없기 때문이다.
    // 그래서 아래 두 검사 함수(`isValidEncryptedCard`·`isValidImage`)가
    // `request.resource.size` 를 보는 순간 조건이 참이 될 수 없고,
    // **삭제가 규칙에서 거부된다.**
    //
    // 실제로 그렇게 됐다. 2026-08-26 실기기 검증에서 **명함을 지웠는데
    // 서버 사진이 그대로 남았다**(객체 103건 → 102건으로 안 돌아옴).
    // 목록으로 대조해 보니 **지워야 할 그 하나가 정확히 남아 있었고**,
    // 엉뚱한 것이 지워지지도 않았다.
    //
    // ⚠️ 그리고 앱은 그 실패를 **조용히 삼킨다**(`CardPhotoBackupService.delete`
    // 가 예외를 `debugPrint` 로만 남긴다). 그래서 아무도 몰랐다.
    //
    // 📌 **이 경로는 2026-08-26에 처음 실제로 돌았다.** 그 전에는 사진 서버
    // 백업 플래그가 꺼져 있어 서버에 객체가 하나도 없었고, 그래서 삭제가
    // 성공했는지 실패했는지 알 방법 자체가 없었다.
    //
    // 🚨 방침과 어긋난다 — `docs/legal/privacy-policy.html` 은
    // *"이용자가 해당 명함을 삭제하거나 회원 탈퇴를 하면 서버에 저장된
    // 사진도 함께 파기됩니다"* 라고 말한다. 남는 것은 **제3자(명함 주인)의
    // 사진**이다.
    //
    // → 앞으로 이 파일에서 `allow write` 를 쓰지 않는다.
    //   **`create, update` 와 `delete` 를 나눠 쓴다.**
    //   내용 검사는 올리는 쪽에만 걸고, 삭제는 소유자 확인만 한다.

    // 명함 사진(암호문) — users/{uid}/cards/{contactId}.enc
    // 아래 일반 규칙보다 먼저 두어야 이 경로가 이미지 검사에 걸리지 않는다.
    match /users/{uid}/cards/{fileName} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidEncryptedCard();
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidImage();
      allow delete: if isOwner(uid);
    }
  }
}
