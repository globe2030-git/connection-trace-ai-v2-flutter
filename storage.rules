rules_version = '2';

// 명함 원본 사진/프로필 사진 저장용 Storage 보안 규칙.
// 원칙: 본인(uid) 소유 폴더만 본인만 읽고 쓸 수 있다. 로그인 안 한 요청은 전부 거부.
// 참고: docs/planning/backlog.md 추가 66, docs/planning/HANDOFF.md "2-0".
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 이미지 파일만, 5MB 이하로 제한 (명함/프로필 사진은 이 정도면 충분히 여유 있음).
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidImage();
    }
  }
}
